PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ns: <http://example.org/ns#>

SELECT ?title ?ceil ?floor ?round ?abs WHERE {
  ?x ns:price ?price .
  ?x ns:discount ?discount .
  ?x dc:title ?title .
  BIND(CEIL(?discount) AS ?ceil)
  BIND(FLOOR(?discount) AS ?floor)
  BIND(CONCAT(STR(ROUND(?discount)), ", ", STR(ROUND(?price))) AS ?round)
  BIND(ABS((?price - ?discount * ?price) - ?price) AS ?abs)
}
ORDER BY ?title
