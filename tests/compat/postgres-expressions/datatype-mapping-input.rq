PREFIX dc: <http://purl.org/dc/elements/1.1/>
PREFIX ns: <http://example.org/ns#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?discount WHERE {
  ?x ns:price ?price .
  ?x dc:title ?title .
  ?x ns:pubYear ?year .
  ?x ns:discount ?discount .
  FILTER(DATATYPE(?discount) = xsd:decimal)
}
ORDER BY ?title
