#    Classes
#################################################################

###  https://example.org/intent-engine/ontology/BalanceObservation
app:BalanceObservation rdf:type owl:Class ;
                       app:provenanceKind "project-extension" .


###  https://example.org/intent-engine/ontology/BookingInstitution
app:BookingInstitution rdf:type owl:Class ;
                       rdfs:subClassOf fibo-fbc-fe:FinancialInstitution ;
                       app:provenanceKind "logical-subclass" ;
                       app:sourceIri "https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/FinancialInstitution" .


