@prefix fibo-fbc-fe: <https://spec.edmcouncil.org/fibo/ontology/FBC/FunctionalEntities/FinancialServicesEntities/> .
@prefix fibo-fbc-debt: <https://spec.edmcouncil.org/fibo/ontology/FBC/DebtAndEquities/Debt/> .
@base <https://example.org/intent-engine/ontology/> .

<https://example.org/intent-engine/ontology/> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  https://example.org/intent-engine/ontology/provenanceKind
app:provenanceKind rdf:type owl:AnnotationProperty .


###  https://example.org/intent-engine/ontology/sourceIri
app:sourceIri rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


