#################################################################

###  https://example.org/intent-engine/ontology/balanceOf
app:balanceOf rdf:type owl:ObjectProperty ;
              rdfs:domain app:BalanceObservation ;
              rdfs:range app:LoanContract ;
              app:provenanceKind "project-extension" .


###  https://example.org/intent-engine/ontology/bookedBy
