app:IdentityDecision rdf:type owl:Class ;
                     app:provenanceKind "project-extension" .


###  https://example.org/intent-engine/ontology/InternalLoanCategory
app:InternalLoanCategory rdf:type owl:Class ;
                         skos:closeMatch fibo-loan:Loan ;
                         app:provenanceKind "weak-close-match" ;
                         app:sourceIri "https://spec.edmcouncil.org/fibo/ontology/LOAN/LoansGeneral/Loans/Loan" .


###  https://example.org/intent-engine/ontology/Lender
app:Lender rdf:type owl:Class ;
           rdfs:subClassOf fibo-fbc-debt:Lender ;
