###  https://example.org/intent-engine/ontology/inRegion
app:inRegion rdf:type owl:ObjectProperty ;
             rdfs:domain app:BookingInstitution ;
             rdfs:range app:Region ;
             app:provenanceKind "project-extension" .


###  https://example.org/intent-engine/ontology/participant
app:participant rdf:type owl:ObjectProperty ;
