@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix ex: <http://example.com/> .

<TriplesMap1> a rr:TriplesMap;
  rr:logicalTable [ rr:sqlQuery "SELECT ('Student' || \"Student\") AS StudentId, \"Student\" FROM \"Student_Sport\"" ];
  rr:subjectMap [ rr:column "StudentId"; rr:termType rr:Literal; rr:class ex:Student ];
  rr:predicateObjectMap [ rr:predicate foaf:name; rr:objectMap [ rr:column "\"Student\"" ] ] .
